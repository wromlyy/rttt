# ============= TELEGRAM BOT =============
# Получи токен у @BotFather в Telegram
BOT_TOKEN=8866301759:AAGZ6YZJho6u2GjhOvENX3cOlIA0ZzlmqsI

# ID администратора(ов) (разделены запятыми)
ADMIN_IDS=123456789,8579582783

# ID чата для логирования ошибок
LOG_CHAT_ID=-5356435006

# ============= ЛОГИРОВАНИЕ =============
# Уровни: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============= ОГРАНИЧЕНИЯ =============
# Максимальный размер файла для анализа (в байтах)
# Дефолт: 10485760 (10 MB)
MAX_FILE_SIZE=10485760

# Максимальное время анализа (в секундах)
# Дефолт: 300 (5 минут)
MAX_ANALYSIS_TIME=300

# Максимум одновременных анализов
# Дефолт: 5
MAX_CONCURRENT_ANALYSIS=5

# Лимит анализов в день для каждого пользователя
# Дефолт: 10
DAILY_LIMIT_PER_USER=10

# ============= АНАЛИЗ =============
# Включить/выключить различные типы анализа (true/false)
ENABLE_SECURITY_ANALYSIS=true
ENABLE_PERFORMANCE_ANALYSIS=true
ENABLE_STYLE_ANALYSIS=true
ENABLE_COMPLEXITY_ANALYSIS=true
ENABLE_DEPENDENCY_ANALYSIS=true

# ============= ГЕНЕРАЦИЯ =============
# Включить/выключить различные форматы вывода (true/false)
ENABLE_CODE_GENERATION=true
ENABLE_DOCUMENTATION=true
ENABLE_JSON_EXPORT=true
ENABLE_HTML_EXPORT=true

# ============= RATE LIMITING =============
# Сообщений в секунду
RATE_LIMIT_MSG_SEC=1

# Сообщений в минуту
RATE_LIMIT_MSG_MIN=30

# Сообщений в час
RATE_LIMIT_MSG_HOUR=500

# ============= КЕШИРОВАНИЕ =============
# Включить кеширование результатов
ENABLE_CACHE=true

# Время жизни кеша (в секундах)
# Дефолт: 3600 (1 час)
CACHE_TTL=3600

# Максимальный размер кеша (в MB)
# Дефолт: 100 MB
MAX_CACHE_SIZE=100

# ============= УВЕДОМЛЕНИЯ =============
# Отправлять ли уведомления об ошибках
ENABLE_ERROR_NOTIFICATIONS=true

# Отправлять ли уведомления о прогрессе анализа
ENABLE_PROGRESS_NOTIFICATIONS=true

# ============= СТАТИСТИКА =============
# Собирать ли статистику использования
ENABLE_STATISTICS=true

# Сохранять статистику в БД (требует БД настроек ниже)
SAVE_STATISTICS_TO_DB=false

# ============= БАЗА ДАННЫХ (опционально) =============
# Тип БД: sqlite, postgresql, mysql
DB_TYPE=sqlite

# Для SQLite:
DB_CONNECTION=sqlite:///bot_analyzer.db

# Для PostgreSQL:
# DB_CONNECTION=postgresql://user:password@localhost:5432/bot_analyzer

# Для MySQL:
# DB_CONNECTION=mysql://user:password@localhost:3306/bot_analyzer

# ============= ЗАПУСК =============
# Хост для веб-сервера (если используется)
WEB_HOST=0.0.0.0

# Порт для веб-сервера (если используется)
WEB_PORT=8080

# ============= РАЗРАБОТКА =============
# Режим отладки
DEBUG=false

# Пропускать проверку токена при отладке
SKIP_TOKEN_VALIDATION=false
